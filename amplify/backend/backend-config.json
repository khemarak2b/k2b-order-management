{
  "api": {
    "orderManagementApi": {
      "dependsOn": [
        {
          "attributes": [
            "Name",
            "Arn"
          ],
          "category": "function",
          "resourceName": "ordersHandler"
        }
      ],
      "providerPlugin": "awscloudformation",
      "service": "API Gateway"
    }
  },
  "auth": {
    "k2bordermanagement": {
      "dependsOn": [],
      "frontendAuthConfig": {
        "mfaConfiguration": "OFF",
        "mfaTypes": [
          "SMS"
        ],
        "passwordProtectionSettings": {
          "passwordPolicyCharacters": [],
          "passwordPolicyMinLength": 8
        },
        "signupAttributes": [
          "EMAIL"
        ],
        "socialProviders": [],
        "usernameAttributes": [],
        "verificationMechanisms": [
          "EMAIL"
        ]
      },
      "providerPlugin": "awscloudformation",
      "service": "Cognito",
      "serviceType": "managed"
    }
  },
  "function": {
    "k2bordermanagementlayer": {
      "build": true,
      "providerPlugin": "awscloudformation",
      "service": "LambdaLayer"
    },
    "ordersHandler": {
      "build": true,
      "dependsOn": [
        {
          "attributes": [
            "Arn"
          ],
          "category": "function",
          "resourceName": "k2bordermanagementlayer"
        }
      ],
      "providerPlugin": "awscloudformation",
      "service": "Lambda"
    }
  }
}